# Environment variables for QuickLink Flutter Application
# Inject during build or test via: flutter run --dart-define-from-file=.env or --dart-define=KEY=VALUE

# AI Vision & Chat Assistant (Groq Cloud)
GROQ_API_KEY=your_groq_api_key_here

# Payment Gateway Public Key
RAZORPAY_KEY_ID=rzp_live_your_key_id_here

